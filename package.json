{
  "name": "retail-sales-intelligence",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "next typegen && npm run frontend:imports && npm run frontend:static && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "audit:prod": "npm audit --omit=dev",
    "frontend:static": "node scripts/verify_frontend_static.mjs",
    "format:check": "biome ci --formatter-enabled=true --linter-enabled=false --assist-enabled=false .",
    "quality": "npm run format:check && npm run check && npm run build && npm run audit:prod",
    "doctor": "node scripts/doctor.mjs",
    "frontend:imports": "node scripts/verify_local_imports.mjs"
  },
  "dependencies": {
    "@tanstack/react-table": "9.2.4",
    "echarts": "6.1.0",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "packageManager": "npm@11.19.0"
}
